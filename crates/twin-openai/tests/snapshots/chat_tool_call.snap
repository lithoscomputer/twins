{
  "status": 200,
  "content_type": "application/json",
  "body": {
    "id": "[id]",
    "object": "chat.completion",
    "created": "[timestamp]",
    "model": "gpt-5-nano-2025-08-07",
    "choices": [
      {
        "index": 0,
        "finish_reason": "tool_calls",
        "message": {
          "role": "assistant",
