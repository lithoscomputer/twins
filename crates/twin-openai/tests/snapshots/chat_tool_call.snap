          "tool_calls": [
            {
              "id": "[id]",
              "type": "function",
              "function": {
                "name": "lookup_weather",
                "arguments": {
                  "city": "Boston"
                }
              }
            }
          ]
        }
      }
    ],
    "usage": {
      "prompt_tokens": "[int]",
      "completion_tokens": "[int]",
      "total_tokens": "[int]"
    }
  }
}
